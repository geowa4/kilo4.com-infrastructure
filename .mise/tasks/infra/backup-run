#!/usr/bin/env bash
#MISE description="Trigger an immediate backup of all configured files"

set -euo pipefail

# Configuration Variables
REGION="us-east-2"
STACK_NAME="${PROJECT_NAME}-Infrastructure"

#####################################################################
# Helper Functions
#####################################################################

log_info() {
    echo "[INFO]  $(date '+%Y-%m-%d %H:%M:%S') $*" >&2
}

log_error() {
    echo "[ERROR] $(date '+%Y-%m-%d %H:%M:%S') $*" >&2
}

log_success() {
    echo "[OK]    $(date '+%Y-%m-%d %H:%M:%S') $*" >&2
}

handle_error() {
    log_error "Script failed at line $1"
    exit 1
}

trap 'handle_error $LINENO' ERR

#####################################################################
# Prerequisites Check
#####################################################################

check_prerequisites() {
    log_info "Checking prerequisites..."

    if ! command -v aws &>/dev/null; then
        log_error "AWS CLI is not installed"
        exit 1
    fi

    if ! aws sts get-caller-identity --region "$REGION" &>/dev/null; then
        log_error "AWS credentials not configured or expired"
        exit 1
    fi

    log_success "Prerequisites validated"
}

#####################################################################
# Get Instance ID
#####################################################################

get_instance_id() {
    log_info "Getting instance ID from CloudFormation stack: $STACK_NAME"

    local instance_id
    instance_id=$(aws cloudformation describe-stacks \
        --stack-name "$STACK_NAME" \
        --region "$REGION" \
        --query "Stacks[0].Outputs[?OutputKey=='InstanceId'].OutputValue" \
        --output text 2>/dev/null)

    if [[ -z $instance_id || $instance_id == "None" ]]; then
        log_error "Could not retrieve instance ID from stack outputs"
        exit 1
    fi

    echo "$instance_id"
}

#####################################################################
# Execute Backup via SSM
#####################################################################

execute_backup() {
    local instance_id="$1"

    log_info "Triggering immediate backup on EC2 instance"

    # Execute systemctl start s3-backup.service via SSM
    local command_id
    command_id=$(aws ssm send-command \
        --document-name "AWS-RunShellScript" \
        --instance-ids "$instance_id" \
        --parameters "commands=['sudo systemctl start s3-backup.service && sleep 2 && sudo journalctl -u s3-backup.service -n 100 --no-pager']" \
        --region "$REGION" \
        --query 'Command.CommandId' \
        --output text)

    log_success "Command sent with ID: $command_id"

    # Wait for completion
    log_info "Waiting for backup to complete..."
    aws ssm wait command-executed \
        --command-id "$command_id" \
        --instance-id "$instance_id" \
        --region "$REGION" 2>/dev/null || true

    # Get output
    local output
    output=$(aws ssm get-command-invocation \
        --command-id "$command_id" \
        --instance-id "$instance_id" \
        --region "$REGION" \
        --query 'StandardOutputContent' \
        --output text)

    echo ""
    echo "Backup Log:"
    echo "----------------------------------------------"
    echo "$output"
    echo "----------------------------------------------"
    echo ""

    # Check status
    local status
    status=$(aws ssm get-command-invocation \
        --command-id "$command_id" \
        --instance-id "$instance_id" \
        --region "$REGION" \
        --query 'Status' \
        --output text)

    if [[ $status != "Success" ]]; then
        log_error "Command failed with status: $status"

        # Get error output
        local error_output
        error_output=$(aws ssm get-command-invocation \
            --command-id "$command_id" \
            --instance-id "$instance_id" \
            --region "$REGION" \
            --query 'StandardErrorContent' \
            --output text)

        if [[ -n $error_output ]]; then
            echo "Error output:" >&2
            echo "$error_output" >&2
        fi

        exit 1
    fi

    log_success "Backup completed successfully"
}

#####################################################################
# Main Function
#####################################################################

main() {
    echo "" >&2
    log_info "Running immediate backup via SSM"
    echo "" >&2

    check_prerequisites

    local instance_id
    instance_id=$(get_instance_id)

    execute_backup "$instance_id"
    echo "" >&2
}

main "$@"
